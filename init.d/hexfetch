#!/sbin/openrc-run

name="hexfetch"
description="Run hexfetch from ramdisk"

command="/mnt/ramdisk/hexfetch/hexfetch-arm"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/hexfetch.log"
error_log="/var/log/hexfetch.log"

depend() {
    need localmount
    after bootmisc
}
    
start_pre() {
    if [ ! -f /mnt/ramdisk/hexfetch/hexfetch-arm ]; then
        mkdir /mnt/ramdisk/hexfetch
        cp /media/mmcblk0p1/hexfetch/hexfetch-arm /mnt/ramdisk/hexfetch || return 1
    fi
}
